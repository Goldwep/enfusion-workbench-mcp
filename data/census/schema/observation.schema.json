                },
                "ext": {
                  "minLength": 1,
                  "type": "string"
                },
                "handler": {
                  "minLength": 1,
                  "type": "string"
                },
                "key": {
                  "minLength": 1,
                  "type": "string"
                },
                "member": {
                  "minLength": 1,
                  "type": "string"
                },
                "method": {
                  "minLength": 1,
