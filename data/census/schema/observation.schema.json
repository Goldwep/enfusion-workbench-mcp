                }
              },
              "required": [],
              "type": "object"
            },
            "kind": {
              "enum": [
                "module",
                "window",
                "menu",
                "menu-item",
                "toolbar",
                "toolbar-button",
                "dock",
                "panel",
                "tab",
                "dialog",
                "control",
                "property-group",
                "property",
