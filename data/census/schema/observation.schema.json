          "type": "string"
        },
        "button": {
          "minLength": 1,
          "type": "string"
        },
        "class": {
          "minLength": 1,
          "type": "string"
        },
        "cli": {
          "minLength": 1,
          "type": "string"
        },
        "ext": {
          "minLength": 1,
          "type": "string"
        },
        "handler": {
          "minLength": 1,
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "type": "string"
        },
        "member": {
          "minLength": 1,
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "native": {
          "minLength": 1,
