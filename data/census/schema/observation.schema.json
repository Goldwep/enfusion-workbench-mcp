    "object_name": {
      "minLength": 1,
      "type": "string"
    },
    "observed_state": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["edit", "play", "prefab-edit"],
          "type": "string"
        },
        "resource_type": {
          "minLength": 1,
          "type": "string"
        },
        "script_debug": {
          "enum": ["on", "off"],
          "type": "string"
        },
        "selection": {
          "enum": [
            "none",
            "entity",
            "prefab-instance",
            "shape",
            "terrain",
            "layer",
            "folder",
            "multi"
          ],
          "type": "string"
        },
        "world_type": {
          "enum": ["with-terrain", "without-terrain"],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "origin": {
      "pattern": "^(vanilla|addon:[A-Za-z0-9_.-]+)$",
      "type": "string"
    },
    "parent_key": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "dim": {
              "enum": [
                "ui",
                "api",
                "plugin",
                "net",
                "cli",
                "file",
                "schema",
                "setting",
                "link",
                "diag",
                "mcp"
              ],
              "type": "string"
            },
            "key": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "minLength": 1,
                  "type": "string"
                },
                "arity": {
                  "minimum": 0,
                  "type": "integer"
                },
                "attr": {
                  "minLength": 1,
