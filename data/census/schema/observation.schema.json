    },
    "label_raw": {
      "minLength": 1,
      "type": "string"
    },
    "locator": {
      "additionalProperties": false,
      "properties": {
        "automationId": {
          "minLength": 1,
          "type": "string"
        },
        "controlType": {
          "minLength": 1,
          "type": "string"
        },
        "menuPath": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "windowClass": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "modal": {
      "enum": ["none", "opens", "blocks"],
      "type": "string"
    },
    "module": {
      "enum": [
        "WorldEditor",
        "ResourceManager",
        "ScriptEditor",
