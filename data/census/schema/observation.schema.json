{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "census/observation.schema.json",
  "title": "Census observation line",
  "description": "One line after the header of data/census/observations/<enumerator>/<build>.jsonl (plan 4.1). additionalProperties is false: tier, state, disposition, MCP links and the enumerator name can never appear in an observation. The header line is described under $defs.header.",
  "$defs": {
    "header": {
      "additionalProperties": false,
      "properties": {
        "$header": {
          "const": 1
        },
        "branch": {
          "enum": ["stable", "experimental"],
          "type": "string"
        },
        "build": {
          "minLength": 1,
          "type": "string"
        },
        "enumerator": {
          "pattern": "^[EL]\\d{2}$",
          "type": "string"
        },
        "generator": {
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": ["path", "sha256"],
            "type": "object"
          },
          "type": "array"
        },
        "provisional": {
          "type": "boolean"
        },
        "row_count": {
          "minimum": 0,
          "type": "integer"
        },
        "ui_language": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["$header", "enumerator", "build", "generator", "provisional", "row_count"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate": {
      "type": "boolean"
    },
    "children_count": {
      "minimum": 0,
      "type": "integer"
    },
    "class_name": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "enum": ["low", "medium", "high"],
      "type": "string"
    },
    "control_type": {
      "minLength": 1,
      "type": "string"
    },
    "covers_proposed": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "dim": {
      "enum": [
        "ui",
        "api",
        "plugin",
        "net",
        "cli",
        "file",
        "schema",
        "setting",
        "link",
        "diag",
        "mcp"
      ],
      "type": "string"
    },
    "dismissed_by": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "key": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "type": "string"
        },
        "arity": {
          "minimum": 0,
          "type": "integer"
        },
        "attr": {
