            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "req": {
          "minLength": 1,
          "type": "string"
        },
        "resp": {
          "minLength": 1,
          "type": "string"
        },
        "section": {
          "minLength": 1,
          "type": "string"
        },
        "switch": {
          "minLength": 1,
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "kind": {
      "enum": [
        "module",
        "window",
        "menu",
        "menu-item",
        "toolbar",
        "toolbar-button",
        "dock",
        "panel",
        "tab",
        "dialog",
