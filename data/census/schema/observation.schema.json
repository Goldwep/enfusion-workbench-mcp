                "none"
              ],
              "type": "string"
            }
          },
          "required": ["dim", "kind", "module", "key"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "paths_proposed": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "enum": [
              "net-api-handler",
              "builtin-net-handler",
              "execute-action",
              "plugin-run",
              "cli",
              "file-format",
              "gui-automation",
              "none-known"
            ],
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["path"],
        "type": "object"
      },
      "type": "array"
    },
    "quote": {
      "minLength": 1,
      "type": "string"
    },
    "recon_coverage": {
      "enum": ["covered", "partial", "none"],
      "type": "string"
