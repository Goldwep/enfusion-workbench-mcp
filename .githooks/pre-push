#!/bin/sh
# pre-push: only refs/heads/public-release may be pushed (2.0 plan, section 5.2).
#
# main, v2, every other branch and every tag stay local: main's history holds
# pre-scrub personal data, and public-release shares no ancestor with it.
# Public content reaches public-release only through scripts/export-public.ts.
#
# Git feeds one line per ref on standard input:
#   <local ref> <local sha> <remote ref> <remote sha>
# Rejected:
#   - any remote ref other than refs/heads/public-release (branches and tags);
#   - pushing anything but the local public-release branch onto it;
#   - deleting a remote ref (the local sha is all zeros);
#   - a push that would not fast-forward the remote public-release (a forced
#     push would rewrite public history; plan decision D8).
# Exit 1 on any rejection, 0 otherwise. POSIX sh only (runs under Git Bash).
#
# Test without touching origin: pipe ref lines into `sh .githooks/pre-push`,
# or push to a local bare repository in a scratch directory.

remote_name=${1:-"(unknown remote)"}
allowed_ref="refs/heads/public-release"
status=0

reject() {
	echo "pre-push: REJECTED $1 -> $remote_name: $2" >&2
	status=1
}

is_zero() {
	case "$1" in
	"" | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "$local_ref$local_sha$remote_ref$remote_sha" ] && continue

	if is_zero "$local_sha"; then
		reject "$remote_ref" "deleting a remote ref is never allowed; only additive pushes of $allowed_ref are permitted."
		continue
	fi

	case "$remote_ref" in
	refs/tags/*)
		reject "$remote_ref" "tags stay local; only $allowed_ref is pushable (plan 5.2)."
		continue
		;;
	"$allowed_ref") ;;
	*)
		reject "$remote_ref" "only $allowed_ref is pushable (plan 5.2); main, v2, every other branch and all tags stay local."
		continue
		;;
	esac

	if [ "$local_ref" != "$allowed_ref" ]; then
		reject "$remote_ref" "only the local $allowed_ref branch may be pushed to it, not $local_ref; publish through scripts/export-public.ts."
		continue
	fi

	if ! is_zero "$remote_sha"; then
		if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
			reject "$remote_ref" "the remote tip $remote_sha is not in this repository, so the push cannot be shown to fast-forward; fetch first."
			continue
		fi
		if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
			reject "$remote_ref" "the push would not fast-forward $remote_sha; rewriting public history is not allowed (plan decision D8)."
			continue
		fi
	fi
done

if [ "$status" -ne 0 ]; then
	echo "pre-push: push blocked. Only $allowed_ref is pushable; see .githooks/README.md." >&2
fi
exit "$status"
