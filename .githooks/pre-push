#!/bin/sh
# pre-push: only the local public-release branch may be pushed, and only to
# the remote branch it publishes to (2.0 plan, section 5.2).
#
# main, v2, every other branch and every tag stay local: main's history holds
# pre-scrub personal data, and public-release shares no ancestor with it.
# Public content reaches public-release only through scripts/export-public.ts.
#
# The remote branch is public-release's configured upstream
# (branch.public-release.merge; refs/heads/main on the owner's machine, where
# public-release tracks origin/main), else the remote branch of the same name.
#
# Git feeds one line per ref on standard input:
#   <local ref> <local sha> <remote ref> <remote sha>
# Rejected:
#   - any remote ref other than that one (branches and tags);
#   - pushing anything but the local public-release branch onto it;
#   - deleting a remote ref (the local sha is all zeros);
#   - a commit that shares any history with local main or v2;
#   - a push that would not fast-forward the remote branch (a forced push
#     would rewrite public history; plan decision D8).
# Exit 1 on any rejection, 0 otherwise. POSIX sh only (runs under Git Bash).
#
# Test without touching origin: pipe ref lines into `sh .githooks/pre-push`,
# or push to a local bare repository in a scratch directory.

remote_name=${1:-"(unknown remote)"}
allowed_local="refs/heads/public-release"
allowed_ref=$(git config --get branch.public-release.merge 2>/dev/null)
[ -n "$allowed_ref" ] || allowed_ref="$allowed_local"
status=0

reject() {
	echo "pre-push: REJECTED $1 -> $remote_name: $2" >&2
	status=1
}

is_zero() {
	case "$1" in
	"" | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "$local_ref$local_sha$remote_ref$remote_sha" ] && continue

	if is_zero "$local_sha"; then
		reject "$remote_ref" "deleting a remote ref is never allowed; only additive pushes of $allowed_ref are permitted."
		continue
	fi

	case "$remote_ref" in
	refs/tags/*)
		reject "$remote_ref" "tags stay local; only $allowed_ref is pushable (plan 5.2)."
		continue
		;;
	"$allowed_ref") ;;
	*)
		reject "$remote_ref" "only $allowed_ref is pushable (plan 5.2); main, v2, every other branch and all tags stay local."
		continue
		;;
	esac

	if [ "$local_ref" != "$allowed_local" ]; then
		reject "$remote_ref" "only the local $allowed_local branch may be pushed to it, not $local_ref; publish through scripts/export-public.ts."
		continue
	fi

	# public-release must never carry local main/v2 history (plan 5.2):
	# the branch is built by scripts/export-public.ts as additive commits and
	# shares no commit with them, so any common ancestor is a leak.
	for private_branch in main v2; do
		if git rev-parse -q --verify "refs/heads/$private_branch" >/dev/null 2>&1 &&
			git merge-base "refs/heads/$private_branch" "$local_sha" >/dev/null 2>&1; then
			reject "$remote_ref" "the commit being pushed shares history with local $private_branch; publish through scripts/export-public.ts instead."
			continue 2
		fi
	done

	if ! is_zero "$remote_sha"; then
		if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
			reject "$remote_ref" "the remote tip $remote_sha is not in this repository, so the push cannot be shown to fast-forward; fetch first."
			continue
		fi
		if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
			reject "$remote_ref" "the push would not fast-forward $remote_sha; rewriting public history is not allowed (plan decision D8)."
			continue
		fi
	fi
done

if [ "$status" -ne 0 ]; then
	echo "pre-push: push blocked. Only $allowed_local -> $allowed_ref is pushable; see .githooks/README.md." >&2
fi
exit "$status"
