{
  "name": "enfusion-workbench-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for Arma Reforger / Enfusion Workbench modding — project-wide GUID/resource indexing, refactoring, script analysis, scenario tooling, and live Workbench control. Derived from steffenbk/enfusion-mcp-BK (MIT).",
  "author": "goldwep",
  "bin": {
    "enfusion-workbench-mcp": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:remote": "tsx scripts/scrape.ts --source remote",
    "scrape:local": "tsx scripts/scrape.ts --source local",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "playwright": "^1.58.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "data",
    "mod",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Goldwep/enfusion-workbench-mcp.git"
  },
  "homepage": "https://github.com/Goldwep/enfusion-workbench-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "arma-reforger",
    "arma-4",
    "enfusion",
    "enfusion-workbench",
    "modding",
    "model-context-protocol",
    "workbench",
    "goldwep"
  ]
}
