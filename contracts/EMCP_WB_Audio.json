  "actions": [
    {
      "name": "play",
      "summary": ".acp event",
      "mutating": true,
      "projectOnly": false,
      "params": [
        {
          "key": "resource",
          "type": "string",
          "required": true,
          "note": ".acp by rel path or {GUID}path"
        },
        {
          "key": "eventName",
          "type": "string",
          "required": true,
          "note": "event (Sound node) name"
        },
        {
          "key": "position",
          "type": "string",
          "required": false,
          "note": "x y z as text; default camera"
        },
        {
          "key": "signals",
          "type": "array<string>",
          "required": false,
          "note": "name=value, value as text"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "handle",
          "type": "int",
          "note": "AudioHandle"
        },
        {
          "key": "playing",
          "type": "bool",
          "note": "!IsSoundPlayed (true = finished)"
        },
        {
          "key": "position",
          "type": "string"
        }
      ],
      "paging": false,
      "refuses": "NO_WORLD; WRONG_MODE; RESOURCE_NOT_FOUND; INVALID_ARGUMENT; PLAY_FAILED (PlayEventInitialize false or invalid handle)"
    },
