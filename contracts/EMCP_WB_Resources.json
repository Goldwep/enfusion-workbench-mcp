    {
      "name": "search",
      "summary": "Paged database search",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "rootPath",
          "type": "string",
          "required": false,
          "note": "$Addon:Folder/ or relative (every addon)"
        },
        {
          "key": "extensions",
          "type": "array<string>",
          "required": false,
          "note": "without the dot"
        },
        {
          "key": "searchStr",
          "type": "array<string>",
          "required": false,
          "note": "all words must match"
        },
        {
          "key": "tags",
          "type": "array<string>",
          "required": false
        },
        {
          "key": "recursive",
          "type": "bool",
          "required": false,
          "note": "default true"
        },
        {
          "key": "cursor",
          "type": "string",
          "required": false,
          "note": "nextCursor of the previous page"
        },
        {
          "key": "limit",
          "type": "int",
          "required": false,
          "note": "default 50, max 200"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "total",
          "type": "int"
        },
        {
          "key": "nextCursor",
          "type": "string"
        },
        {
          "key": "capped",
          "type": "bool"
        },
        {
          "key": "items",
          "type": "array<string>",
          "note": "ResourceName; unregistered: $Addon:path"
        }
      ],
      "paging": true
    },
