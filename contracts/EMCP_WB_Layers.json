        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "layer",
          "type": "string",
          "note": "path returned"
        },
        {
          "key": "layerId",
          "type": "int"
        },
        {
          "key": "undoName",
          "type": "string",
          "note": "history point name used"
        }
      ],
      "paging": false
    },
