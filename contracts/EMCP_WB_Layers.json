{
  "$schema": "./_schema/contract.schema.json",
  "handler": "EMCP_WB_Layers",
  "tool": "wb_layers",
  "purpose": "Layers and folders of the open world.",
  "source": "mod/Scripts/WorkbenchGame/EnfusionMCP/EMCP_WB_Layers.c",
  "request": [
    "action",
    "subScene",
    "cursor",
    "limit",
    "name",
    "parentPath",
    "layer",
    "confirm",
    "withContents"
  ],
  "response": [
    "status",
    "code",
    "next",
    "message",
    "action",
    "currentSubScene",
    "rows",
    "subScenes",
    "activeLayer",
    "total",
    "nextCursor",
    "layer",
    "layerId",
    "undoName",
    "before",
    "after",
    "entityCount",
    "childCount",
    "entitiesDeleted",
    "dryRun",
    "layerLocked"
  ],
  "actions": [
    {
      "name": "list",
      "summary": "Layers of a sub-scene by id",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "subScene",
          "type": "int",
          "required": false,
          "note": "default: current"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "currentSubScene",
          "type": "int"
        },
        {
          "key": "rows",
          "type": "array<string>",
          "note": "id|path|visible|locked|count"
        }
      ],
      "paging": false
    },
    {
      "name": "tree",
      "summary": "Layer and folder tree, paged",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "subScene",
          "type": "int",
          "required": false,
          "note": "default: every sub-scene"
        },
        {
          "key": "cursor",
          "type": "string",
          "required": false,
          "note": "nextCursor of the previous page"
        },
        {
          "key": "limit",
          "type": "int",
          "required": false,
          "note": "default 50, max 200"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "subScenes",
          "type": "int"
        },
        {
          "key": "activeLayer",
          "type": "string"
        },
        {
          "key": "rows",
          "type": "array<string>",
          "note": "sub|path|id|kind|vis|lock|lockH|count"
        },
        {
          "key": "total",
          "type": "int",
          "note": "items before paging"
        },
        {
          "key": "nextCursor",
          "type": "string",
          "note": "empty on the last page"
        }
      ],
      "paging": true
    },
