      "projectOnly": true,
      "params": [
        {
          "key": "name",
          "type": "string",
          "required": true
        },
        {
          "key": "parentPath",
          "type": "string",
          "required": false,
          "note": "folder path"
        },
        {
          "key": "subScene",
          "type": "int",
          "required": false,
          "note": "default: current"
        }
      ],
      "response": [
        {
          "key": "status",
