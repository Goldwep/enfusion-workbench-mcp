{
  "$schema": "./_schema/contract.schema.json",
  "handler": "EMCP_WB_View",
  "tool": "wb_view",
  "purpose": "World Editor selection, visibility and camera.",
  "source": "mod/Scripts/WorkbenchGame/EnfusionMCP/EMCP_WB_View.c",
  "request": [
    "action",
    "cursor",
    "limit",
    "mode",
    "entities",
    "visible",
    "recursive",
    "coords",
    "look",
    "entity",
    "distance",
    "x",
    "y",
    "flags",
    "clamped",
    "prefab",
    "name",
    "layer",
    "window"
  ],
  "response": [
    "status",
    "code",
    "next",
    "message",
    "action",
    "rows",
    "mainId",
    "total",
    "nextCursor",
    "selectedCount",
    "missing",
    "previous",
    "changed",
    "coords",
    "angles",
    "direction",
    "screenWidth",
    "screenHeight",
    "before",
    "after",
    "id",
    "hit",
    "start",
    "end",
    "x",
    "y",
    "undoName"
  ],
  "actions": [
    {
      "name": "selection",
      "summary": "Selected entities, paged",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "cursor",
          "type": "string",
          "required": false,
          "note": "nextCursor of the previous page"
        },
        {
          "key": "limit",
          "type": "int",
          "required": false,
          "note": "default 50, max 200"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "rows",
          "type": "array<string>",
          "note": "id|name|class|parent|layer|sub|kids"
        },
        {
          "key": "mainId",
          "type": "string"
        },
        {
          "key": "total",
          "type": "int",
          "note": "items before paging"
        },
        {
          "key": "nextCursor",
          "type": "string",
          "note": "empty on the last page"
        }
      ],
      "paging": true
    },
    {
      "name": "select",
      "summary": "Set, add, remove or clear selection",
      "mutating": true,
      "projectOnly": true,
      "params": [
        {
          "key": "mode",
          "type": "string",
          "required": true,
          "note": "set, add, remove or clear"
        },
        {
          "key": "entities",
          "type": "array<string>",
          "required": false,
          "note": "refs; not for clear"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "selectedCount",
          "type": "int"
        },
        {
          "key": "missing",
          "type": "array<string>"
        },
        {
          "key": "previous",
          "type": "array<string>",
          "note": "ids selected before"
        }
      ],
      "paging": false
    },
    {
      "name": "setVisible",
      "summary": "Hide or show entities",
      "mutating": true,
      "projectOnly": true,
      "params": [
        {
          "key": "entities",
          "type": "array<string>",
          "required": true,
          "note": "refs"
        },
        {
          "key": "visible",
          "type": "bool",
          "required": true
        },
        {
          "key": "recursive",
          "type": "bool",
          "required": false,
          "note": "default true"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "changed",
          "type": "array<string>",
          "note": "id|visibleAfter"
        },
        {
          "key": "missing",
          "type": "array<string>"
        },
        {
          "key": "undoName",
          "type": "string",
          "note": "history point name used"
        }
      ],
      "paging": false
    },
    {
      "name": "camera",
      "summary": "Position, angles, screen size",
      "mutating": false,
      "projectOnly": false,
      "params": [],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "coords",
          "type": "string"
        },
        {
          "key": "angles",
          "type": "string"
        },
        {
          "key": "direction",
          "type": "string"
        },
        {
          "key": "screenWidth",
          "type": "int"
        },
        {
          "key": "screenHeight",
          "type": "int"
        }
      ],
      "paging": false
    },
    {
      "name": "setCamera",
      "summary": "Move the camera",
      "mutating": true,
      "projectOnly": true,
      "params": [
        {
          "key": "coords",
          "type": "string",
          "required": true,
          "note": "\"x y z\""
        },
        {
          "key": "look",
          "type": "string",
          "required": true,
          "note": "\"x y z\" look direction"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "before",
          "type": "string"
        },
        {
          "key": "after",
          "type": "string",
          "note": "camera coords read back"
        }
      ],
      "paging": false
    },
    {
      "name": "focus",
      "summary": "Aim the camera at an entity",
      "mutating": true,
      "projectOnly": true,
      "params": [
        {
          "key": "entity",
          "type": "string",
          "required": true,
          "note": "id:<hex> | name:<n> | index:<i>"
        },
        {
          "key": "distance",
          "type": "float",
          "required": false,
          "note": "metres; default frames the bounds"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "id",
          "type": "string"
        },
        {
          "key": "before",
          "type": "string",
          "note": "camera coords before"
        },
        {
          "key": "after",
          "type": "string",
          "note": "camera coords read back"
        }
      ],
      "paging": false
    },
    {
      "name": "trace",
      "summary": "Ray from a pixel: hit and entity",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "x",
          "type": "int",
          "required": true,
          "note": "viewport pixel"
        },
        {
          "key": "y",
          "type": "int",
          "required": true,
          "note": "viewport pixel"
        },
        {
          "key": "flags",
          "type": "string",
          "required": false,
          "note": "TraceFlags names, comma-joined"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "hit",
          "type": "bool"
        },
        {
          "key": "start",
          "type": "string"
        },
        {
          "key": "end",
          "type": "string"
        },
        {
          "key": "direction",
          "type": "string"
        },
        {
          "key": "id",
          "type": "string",
          "note": "hit entity, empty if none"
        }
      ],
      "paging": false
    },
    {
      "name": "underCursor",
      "summary": "Entity under the mouse",
      "mutating": false,
      "projectOnly": false,
      "params": [
        {
          "key": "clamped",
          "type": "bool",
          "required": false,
          "note": "clamp to the viewport"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "x",
          "type": "int"
        },
        {
          "key": "y",
          "type": "int"
        },
        {
          "key": "id",
          "type": "string",
          "note": "empty if none"
        }
      ],
      "paging": false
    },
    {
      "name": "placeAtPixel",
      "summary": "Create an entity at a pixel",
      "mutating": true,
      "projectOnly": true,
      "params": [
        {
          "key": "x",
          "type": "int",
          "required": true
        },
        {
          "key": "y",
          "type": "int",
          "required": true
        },
        {
          "key": "prefab",
          "type": "string",
          "required": true,
          "note": "class name or {GUID}path"
        },
        {
          "key": "name",
          "type": "string",
          "required": false
        },
        {
          "key": "layer",
          "type": "string",
          "required": false,
          "note": "layer path; default active"
        },
        {
          "key": "window",
          "type": "int",
          "required": false,
          "note": "window type, default 0"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
          "note": "error code; empty when ok"
        },
        {
          "key": "next",
          "type": "string"
        },
        {
          "key": "message",
          "type": "string"
        },
        {
          "key": "action",
          "type": "string"
        },
        {
          "key": "id",
          "type": "string"
        },
        {
          "key": "coords",
          "type": "string"
        },
        {
          "key": "undoName",
          "type": "string",
          "note": "history point name used"
        }
      ],
      "paging": false
    }
  ]
}
