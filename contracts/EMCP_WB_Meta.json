        {
          "key": "platform",
          "type": "string",
          "required": false,
          "note": "default PC"
        },
        {
          "key": "allPlatforms",
          "type": "bool",
          "required": false,
          "note": "write every configuration"
        },
        {
          "key": "confirm",
          "type": "bool",
          "required": false,
          "note": "true writes; else a dry run"
        }
      ],
      "response": [
        {
          "key": "status",
          "type": "string",
          "note": "ok, error or refused"
        },
        {
          "key": "code",
          "type": "string",
