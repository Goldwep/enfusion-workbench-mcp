        {
          "key": "after",
          "type": "array<string>",
          "note": "PLATFORM=value"
        },
        {
          "key": "saved",
          "type": "bool"
        },
        {
          "key": "dryRun",
          "type": "bool"
        }
      ],
      "paging": false
    },
